# Copy to .env.local for `vercel dev`, and set the same keys in
# Vercel → Project → Settings → Environment Variables for the live site.
#
# Nothing here is committed — .gitignore excludes .env* except this example.

# ── Supabase (project: pexqzghhjiwvvxbiirkr) ───────────────────────────────
# URL and anon key are public by design; they end up in page source either way.
SUPABASE_URL=https://pexqzghhjiwvvxbiirkr.supabase.co
SUPABASE_ANON_KEY=

# SECRET. Bypasses all row-level security. Server-side only — never put this
# in an HTML file. Supabase dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile ───────────────────────────────────────────────────
# dash.cloudflare.com → Turnstile → Add site.
# Leave both blank and the bot check is skipped, so the site still works.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Resend ─────────────────────────────────────────────────────────────────
# resend.com → API Keys. The domain in RESEND_FROM must be verified first,
# under resend.com → Domains. Leave blank and email features stay switched off.
RESEND_API_KEY=
RESEND_FROM=Matthew Lehman Media <noreply@matthewlehmanmedia.com>

# Where contact-form enquiries are delivered.
OWNER_EMAIL=soursauce29@gmail.com

# ── Site ───────────────────────────────────────────────────────────────────
# Used to build the links inside emails, so it must be the real public URL.
SITE_URL=https://www.matthewlehmanmedia.com
